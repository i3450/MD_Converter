# Copiá este archivo con el nombre ".env" (sin ".example") y completá tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore). Nunca lo compartas.
#
# Todo esto es OPCIONAL: sin estas variables el script convierte igual,
# pero no describe imágenes.

AZURE_OPENAI_API_KEY=tu-clave-aca
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=nombre-de-tu-deployment

# Opcional (por defecto: 2024-08-01-preview)
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
