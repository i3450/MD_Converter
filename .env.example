# Copiá este archivo con el nombre ".env" (junto a md_converter.py) y completá UNA de las dos opciones.
# El .env no se sube a GitHub: no lo compartas. Si no completás nada, el script convierte todo
# pero no describe imágenes.

# --- Opción A: OpenAI ---
OPENAI_API_KEY=
# Opcional. Si lo dejás vacío se usa gpt-5.4-mini. Elegí un modelo que acepte imágenes.
OPENAI_MODEL=

# --- Opción B: Azure OpenAI (si completás estas tres, tienen prioridad sobre la opción A) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Nombre que le pusiste al desplegar el modelo (no el nombre del modelo)
AZURE_OPENAI_DEPLOYMENT=
# Opcional. Por defecto 2024-08-01-preview. Con modelos nuevos puede hacer falta una versión más reciente.
# AZURE_OPENAI_API_VERSION=
